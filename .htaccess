RewriteEngine On

# Block direct access to sensitive files
RewriteRule ^params\.php$ - [F,L]
RewriteRule ^\.env$ - [F,L]

# Security headers
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# Force HTTPS and strip www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Clean URLs: /info-changelog -> /info-changelog.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^info-changelog/?$ /info-changelog.html [L]

# Clean URL: /calculadora -> /calculadora.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^calculadora/?$ /calculadora.html [L]

# Clean URL: /sobre-nosotros -> /sobre-nosotros.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sobre-nosotros/?$ /sobre-nosotros.html [L]

# Clean URL: /soporte -> /soporte.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^soporte/?$ /soporte.php [L]

# Clean URLs: /comunidad -> /comunidad.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^comunidad/?$ /comunidad.html [L]

# Clean URLs: /noticias -> /noticias.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^noticias/?$ /noticias.html [L]

# Clean URLs: /tops -> /tops.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tops/?$ /tops.html [L]

# Clean URL: /historia-wow-core -> /historia-wow-core.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^historia-wow-core/?$ /historia-wow-core.html [L]

# Legal deep links -> legal-page.php (serves correct meta tags)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(terminos-de-servicio|politica-de-privacidad)/?$ /legal-page.php [L]

# Guía deep links -> standalone guide pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^guias/([a-z0-9-]+)/?$ /guias/$1.html [L]

# Deep links para abrir modales directamente -> comunidad.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(abrir-ticket|reportar-bug|highlights-gameplays)/?$ /comunidad.html [L]
