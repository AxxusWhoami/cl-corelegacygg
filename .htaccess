RewriteEngine On

# Force HTTPS and strip www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Clean URLs: /info-changelog -> /info-changelog.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^info-changelog/?$ /info-changelog.html [L]

# Clean URLs: /comunidad -> /comunidad.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^comunidad/?$ /comunidad.html [L]

# Legal deep links -> index.html (modal opened via JS based on path)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(terminos-de-servicio|politica-de-privacidad)/?$ /index.html [L]

# /caracteristicas -> /index.html (scroll handled by JS based on path)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^caracteristicas/?$ /index.html [L]

# Guía deep links -> comunidad.html (modal opened via JS based on path)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^guias/([a-z0-9-]+)/?$ /comunidad.html [L]

# Deep links para abrir modales directamente -> comunidad.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(abrir-ticket|reportar-bug)/?$ /comunidad.html [L]
